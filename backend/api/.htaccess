# Hostinger / LiteSpeed — keep this file inside public_html/backend/api/
DirectoryIndex index.php

# Authorization header (do NOT use RewriteRule .* here — causes 403 on LiteSpeed)
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If /backend/api/products returns 404, uncomment ONE line for your path:
  # RewriteBase /backend/api/

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?path=$1 [QSA,L]
</IfModule>
