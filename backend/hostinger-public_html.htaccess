# Copy to public_html as ".htaccess" AFTER you upload Frontend dist (index.html + assets/)
DirectoryIndex index.html index.php

# Block sensitive files in web root
<FilesMatch "^(db\.sql|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # PHP API — do not rewrite to React
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /index.html [L]
</IfModule>
