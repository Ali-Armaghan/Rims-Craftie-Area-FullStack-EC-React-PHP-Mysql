# Storefront (React SPA) — copy to public_html root with index.html + assets/
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite backend API or uploaded images
  RewriteRule ^backend/ - [L]

  # Serve real files and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other routes → React
  RewriteRule ^ index.html [L]
</IfModule>
