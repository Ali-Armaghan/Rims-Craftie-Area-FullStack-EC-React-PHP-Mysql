# Hostinger / LiteSpeed — put in public_html WITH index.html (from npm run build)
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API + uploads: do not send to React
  RewriteRule ^backend/ - [L]

  # Existing files/folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React SPA (only if index.html exists in this folder)
  RewriteRule . /index.html [L]
</IfModule>
